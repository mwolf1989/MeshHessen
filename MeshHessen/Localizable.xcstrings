    },
    "Use exFAT with the smallest available allocation unit (for example 4096 bytes). Map folders contain many small files, so a small allocation unit saves considerable space. FAT32 can be used for older cards and devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende exFAT mit der kleinsten verfügbaren Zuordnungseinheit, zum Beispiel 4096 Byte. Kartenordner enthalten viele kleine Dateien, daher spart eine kleine Zuordnungseinheit erheblich Platz. Für ältere Karten und Geräte kann FAT32 verwendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use exFAT with the smallest available allocation unit (for example 4096 bytes). Map folders contain many small files, so a small allocation unit saves considerable space. FAT32 can be used for older cards and devices."
          }
        }
      }
    },
